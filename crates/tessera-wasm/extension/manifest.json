{
  "manifest_version": 3,
  "name": "Tessera Presentation (scaffold)",
  "version": "0.0.1",
  "description": "Attaches a Tessera-Presentation ARC credential header to outgoing requests. SCAFFOLD — see README.md; the live-origin final mile is human-gated.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8090/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "121"
}
